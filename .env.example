# Booking confirmation emails (EmailJS)
#
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (connect your Gmail/SMTP)
# 3. Create a Template. It must contain these merge fields, which the app
#    sends automatically:
#       {{to_email}}          -> "To" in the EmailJS template settings
#       {{client_name}}
#       {{booking_code}}
#       {{service_name}}
#       {{branch_name}}
#       {{branch_address}}
#       {{branch_phone}}
#       {{date_time}}
#       {{client_phone}}
#       {{client_notes}}
#       {{reply_to}}
# 4. Copy the three values below into a file named `.env` in the project root
#    (same folder as package.json). Do NOT commit `.env`.
#
# Until these are set the booking still works and is still recorded, but the
# site will not claim an email was sent.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Where replies to the guest should go. Optional.
VITE_EMAILJS_REPLY_TO=

# Job applications (Careers page "Apply Now").
#
# Uses the same Email Service and Public Key as above, but needs its OWN
# template, because the booking template does not have these fields:
#       {{applicant_name}}
#       {{applicant_email}}
#       {{applicant_phone}}
#       {{applicant_address}}
#       {{applicant_resume}}    -> set this to an Attachment in the template
#       {{job_title}}
#       {{job_location}}
#       {{job_department}}
#       {{reply_to}}
#
# Until this is set, the apply form still validates and shows a confirmation,
# but it tells the applicant to email their resume to recruit@healthyhome.com.np
# rather than claiming the application was sent.
VITE_EMAILJS_CAREERS_TEMPLATE_ID=

# Franchise inquiries (Franchise page "Submit Inquiry" form).
#
# Same Email Service and Public Key, needs its OWN template again, because the
# franchise desk fields are different to both booking and applications:
#       {{to_email}}            -> "To" in the EmailJS template settings
#       {{reply_to}}           -> the enquirer's own email, so replies reach them
#       {{enquirer_name}}
#       {{enquirer_email}}
#       {{enquirer_phone}}            -> dial code and number joined, e.g. "+977 9812345678"
#       {{enquirer_phone_country}}    -> just the dialling code, e.g. "+977"
#       {{enquirer_location}}
#       {{enquirer_city}}
#       {{investment_range}}
#       {{enquirer_notes}}
#
# Until this is set, the form still validates and shows a confirmation summary,
# but it tells the prospect to write to franchise@healthyhome.com.np directly
# rather than claiming the inquiry was sent.
VITE_EMAILJS_FRANCHISE_TEMPLATE_ID=
